{
  "id": "https://aurum-stream.sharmashivam9109.workers.dev/",
  "name": "Aurum",
  "short_name": "Aurum",
  "description": "Stream millions of songs — powered by JioSaavn",
  "start_url": "https://aurum-stream.sharmashivam9109.workers.dev/?source=pwa",
  "scope": "https://aurum-stream.sharmashivam9109.workers.dev/",

  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],

  "orientation": "portrait-primary",
  "background_color": "#050508",
  "theme_color": "#050508",
  "prefer_related_applications": false,
  "lang": "en-IN",
  "dir": "ltr",

  "launch_handler": {
    "client_mode": "focus-existing"
  },

  "handle_links": "preferred",

  "icons": [
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Search Songs",
      "short_name": "Search",
      "description": "Find any song or artist",
      "url": "/?page=search&source=shortcut",
      "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My Library",
      "short_name": "Library",
      "description": "Your saved songs and playlists",
      "url": "/?page=library&source=shortcut",
      "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Continue Listening",
      "short_name": "Resume",
      "description": "Pick up where you left off",
      "url": "/?resume=true&source=shortcut",
      "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }]
    }
  ],

  "categories": ["music", "entertainment", "lifestyle"],

  "screenshots": [
    {
      "src": "/static/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Aurum — Stream & Discover"
    }
  ],

  "share_target": {
    "action": "/?share-target",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },

  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/mp4": [".m4a"],
        "audio/ogg": [".ogg"],
        "audio/flac": [".flac"],
        "audio/wav": [".wav"]
      }
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+aurum",
      "url": "/?protocol=%s"
    }
  ],

  "related_applications": [],

  "edge_side_panel": {
    "preferred_width": 400
  }
}
